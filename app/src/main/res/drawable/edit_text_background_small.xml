<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 背景色 -->
    <solid android:color="@color/app_dialog_surface_elevated" />
    <!-- 边框 -->
