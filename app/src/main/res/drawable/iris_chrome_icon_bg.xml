<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/iris_glass_strong" />
            <stroke
                android:width="2dp"
                android:color="@color/iris_cyan" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/iris_glass_strong" />
            <stroke
                android:width="2dp"
                android:color="@color/iris_cyan" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/iris_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/iris_glass_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
