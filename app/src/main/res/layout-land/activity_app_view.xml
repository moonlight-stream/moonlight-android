<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/advance_setting_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".AppView">

    <!-- 背景图容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 高斯模糊背景 -->
        <ImageView
            android:id="@+id/appBackgroundImageBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 中间完整图片 -->
        <com.limelight.utils.AcrylicImageView
            android:id="@+id/appBackgroundImageClear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- App 图标网格容器 -->
    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true" />

    <!-- 选中框动画 -->
    <View
        android:id="@+id/selectionIndicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/selection_indicator"
        android:visibility="invisible"
        android:elevation="8dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <View
        android:id="@+id/topPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 顶部下拉手柄标签 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/topPanelToggle"
        android:layout_width="84dp"
        android:layout_height="36dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/activity_safearea_top"
        android:elevation="4dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false" />

    <!-- 顶部下拉面板 -->

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/topDropdownPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topPanelToggle"
        android:layout_marginTop="-32dp"
        android:layout_centerHorizontal="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="@dimen/appview_panel_elevation"
        android:visibility="invisible" />

    <!-- 标题区域（电脑名 + 应用名 + 恢复箭头） -->
    <TextView
        android:id="@+id/appListText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/topPanelToggle"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/appview_content_margin"
        android:layout_marginEnd="@dimen/appview_content_margin"
        android:gravity="end"
        android:paddingBottom="@dimen/appview_content_padding"
        android:preferKeepClear="true"
        android:textSize="24sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeStepGranularity="1sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/appview_text_primary"
        android:shadowColor="@color/appview_text_shadow"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="normal"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 底部信息容器 -->
    <LinearLayout
        android:id="@+id/bottomInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appview_content_margin"
        android:layout_marginEnd="@dimen/appview_content_margin"
        android:layout_marginBottom="@dimen/appview_bottom_margin"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 上一次设置信息 -->
        <LinearLayout
            android:id="@+id/lastSettingsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/useLastSettingsCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:text="@string/app_last_settings_use_checkbox"
                android:textColor="@color/appview_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:buttonTint="@color/appview_text_primary"
                android:checked="false" />

            <TextView
                android:id="@+id/lastSettingsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/appview_text_secondary"
                android:shadowColor="@color/appview_text_shadow"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:fontFamily="sans-serif-light"
                android:background="@drawable/settings_info_background"
                android:padding="@dimen/appview_edge_margin"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:text="@string/app_last_settings_title" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/screenCombinationModeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_combination_mode_picker_background"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone" />

</RelativeLayout>
