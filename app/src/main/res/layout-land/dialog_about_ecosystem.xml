<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_about_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp">

        <ScrollView
            android:id="@+id/about_ecosystem_menu_scroll"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/about_ecosystem_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="18dp"
            android:background="@color/about_dialog_panel_outline" />

        <ScrollView
            android:id="@+id/about_ecosystem_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingEnd="42dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/about_ecosystem_detail_badge"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@drawable/about_dialog_ecosystem_badge_bg"
                    android:gravity="center"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_ecosystem_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/app_dialog_title_color"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_ecosystem_detail_platform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_ecosystem_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/app_dialog_subtitle_color"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/about_ecosystem_open_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/about_dialog_text_action_bg"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/about_dialog_ecosystem_open_action"
                    android:textAllCaps="false"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_dialog_ecosystem_footer"
                    android:textColor="@color/app_dialog_subtitle_color"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.limelight.ui.DialogSideScrollbarView
        android:id="@+id/about_ecosystem_scrollbar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="10dp"
        android:elevation="6dp" />

    <ImageButton
        android:id="@+id/about_ecosystem_close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/about_dialog_close_button_bg"
        android:contentDescription="@string/about_dialog_close"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_about_close" />
</FrameLayout>
