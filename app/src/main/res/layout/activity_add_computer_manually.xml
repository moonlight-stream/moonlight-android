<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.limelight.ui.console.AmbientBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/iris_glass_panel"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_label"
            android:src="@drawable/iris_logo" />

        <TextView
            android:id="@+id/manuallyAddPcText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/console_add_host"
            style="@style/IrisHeaderText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/console_add_host_body"
            android:textColor="@color/iris_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/hostTextView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/iris_cyan"
            android:hint="@string/ip_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:nextFocusDown="@id/addPcButton"
            android:singleLine="true"
            android:textColor="@color/iris_text_primary"
            android:textColorHint="@color/iris_text_secondary" />

        <Button
            android:id="@+id/addPcButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="end"
            android:layout_marginTop="22dp"
            android:background="@drawable/iris_button_selector"
            android:minWidth="132dp"
            android:nextFocusUp="@id/hostTextView"
            android:text="@string/console_add_host"
            android:textColor="@color/iris_text_primary" />
    </LinearLayout>
</FrameLayout>
