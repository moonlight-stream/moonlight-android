<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.limelight.ui.console.AmbientBackgroundView
        android:id="@+id/ambientBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/backdropFirst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/backdropSecond"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/iris_backdrop_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/console_screen_padding"
        android:paddingEnd="@dimen/console_screen_padding"
        android:paddingBottom="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allGamesGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingTop="@dimen/console_app_grid_padding_top"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <include layout="@layout/console_hint_bar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/console_app_header_height"
        android:layout_gravity="top"
        android:background="@drawable/iris_app_header_scrim"
        android:clickable="false"
        android:elevation="24dp"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/console_screen_padding"
            android:paddingEnd="@dimen/console_screen_padding">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/app_label"
                android:src="@drawable/iris_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:importantForAccessibility="no"
                android:textColor="@color/iris_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:textColor="@color/iris_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectedGameTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="84dp"
            android:layout_marginEnd="138dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/console_all_games"
            android:textColor="@color/iris_text_primary"
            android:textSize="20sp" />
    </FrameLayout>
</FrameLayout>
