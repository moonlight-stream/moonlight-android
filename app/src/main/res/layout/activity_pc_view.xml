<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.limelight.ui.console.AmbientBackgroundView
        android:id="@+id/ambientBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/console_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_label"
                android:src="@drawable/iris_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/console_hosts"
                style="@style/IrisHeaderText" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:importantForAccessibility="no"
                android:textColor="@color/iris_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:textColor="@color/iris_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/iris_button_selector"
                android:contentDescription="@string/console_settings"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/console_settings"
                android:textAllCaps="false"
                android:textColor="@color/iris_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/manuallyAddPc"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/iris_button_selector"
                android:contentDescription="@string/console_add_host"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/console_add_host"
                android:textAllCaps="false"
                android:textColor="@color/iris_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hostHero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/hostHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/console_searching_title"
                style="@style/IrisHeroTitle" />

            <TextView
                android:id="@+id/hostHeroStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="680dp"
                android:text="@string/console_searching_body"
                android:textColor="@color/iris_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="190dp">

            <com.limelight.ui.console.ConsoleShelfView
                android:id="@+id/hostShelf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="72dp"
                android:paddingBottom="18dp" />

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/iris_glass_panel"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/iris_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/console_searching_title"
                    android:textColor="@color/iris_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>

        <include layout="@layout/console_hint_bar" />
    </LinearLayout>
</FrameLayout>
