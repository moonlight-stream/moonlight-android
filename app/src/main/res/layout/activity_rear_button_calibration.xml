<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.limelight.ui.console.AmbientBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/console_screen_padding_compact">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/title_rear_button_calibration"
            style="@style/IrisHeaderText" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/iris_glass_dark_panel"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="18dp"
                android:paddingEnd="22dp"
                android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/rear_button_calibration_instructions"
                android:textColor="@color/iris_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/rear_button_target_label"
                style="@style/IrisEyebrowText" />

            <Spinner
                android:id="@+id/rearTargetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/iris_glass_panel"
                android:minHeight="42dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rear_button_count_label"
                style="@style/IrisEyebrowText" />

            <Spinner
                android:id="@+id/rearCountSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/iris_glass_panel"
                android:minHeight="42dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                android:id="@+id/rearStatusText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/iris_cyan"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/rearSaveButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/iris_button_selector"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_save_rear_buttons"
                android:textAllCaps="false"
                android:textColor="@color/iris_text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rearRestartButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/iris_button_selector"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/action_restart_rear_button_capture"
                    android:textAllCaps="false"
                    android:textColor="@color/iris_text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/rearClearButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/iris_button_selector"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/action_clear_rear_button_profiles"
                    android:textAllCaps="false"
                    android:textColor="@color/iris_error"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/rearCancelButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/iris_button_selector"
                    android:fontFamily="sans-serif-medium"
                    android:text="@android:string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/iris_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
