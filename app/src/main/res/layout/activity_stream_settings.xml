<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".preferences.StreamSettings">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 主内容区域 -->
        <RelativeLayout
            android:id="@+id/stream_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/settingsBackgroundImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <View
                android:id="@+id/settingsBackgroundOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/settings_background_overlay" />

            <!-- 设置内容区域（顶部留出菜单按钮空间） -->
            <FrameLayout
                android:id="@+id/preference_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingTop="@dimen/activity_safearea_top"/>

            <!-- 浮动菜单按钮（右上角）- 精致圆形设计 -->
            <ImageView
                android:id="@+id/settings_menu_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/activity_safearea_top"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_menu_stylish"
                android:background="@drawable/menu_button_background_stylish"
                android:scaleType="center"
                android:padding="10dp"
                android:elevation="6dp"
                android:contentDescription="@string/menu" />

            <!-- 浮动搜索按钮（菜单按钮左侧）- 同风格 -->
            <ImageView
                android:id="@+id/settings_search_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@id/settings_menu_toggle"
                android:layout_marginTop="@dimen/activity_safearea_top"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_search_stylish"
                android:background="@drawable/menu_button_background_stylish"
                android:scaleType="center"
                android:padding="10dp"
                android:elevation="6dp"
                android:contentDescription="@string/settings_search_hint" />

            <!-- 顶部搜索栏（默认隐藏，点击搜索按钮后展开） -->
            <LinearLayout
                android:id="@+id/settings_search_bar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/activity_safearea_top"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/settings_search_bar_background"
                android:elevation="6dp"
                android:visibility="gone"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_stylish"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/settings_search_hint" />

                <EditText
                    android:id="@+id/settings_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/settings_search_hint"
                    android:textColor="@color/ui_shell_text_primary"
                    android:textColorHint="@color/ui_shell_text_secondary"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <ImageView
                    android:id="@+id/settings_search_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close_stylish"
                    android:scaleType="center"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_search_close" />

            </LinearLayout>

        </RelativeLayout>

        <!-- 侧边抽屉菜单 - 精致风格 -->
        <LinearLayout
            android:id="@+id/drawer_menu"
            android:layout_width="@dimen/drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="@drawable/drawer_background"
            android:paddingTop="@dimen/activity_safearea_top"
            android:fitsSystemWindows="true"
            android:elevation="8dp">

            <!-- 顶部品牌区域（紧凑） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">

                <!-- 圆形品牌图标 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#222222">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/vplus"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 分类列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 版本号 -->
            <TextView
                android:id="@+id/drawer_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="12dp"
                android:paddingTop="8dp"
                android:textSize="10sp"
                android:textColor="#44FF6B9D"
                android:letterSpacing="0.05"
                android:fontFamily="monospace" />

        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

    <FrameLayout
        android:id="@+id/screen_combination_mode_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_combination_mode_picker_background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
