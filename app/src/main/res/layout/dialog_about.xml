<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_about_bg">

    <ScrollView
        android:id="@+id/about_dialog_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="32dp"
            android:paddingBottom="72dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/app_label"
                android:scaleType="fitCenter"
                android:src="@drawable/vplus" />

            <TextView
                android:id="@+id/text_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Moonlight V+"
                android:textColor="@color/app_dialog_title_color"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 0.0.0 (Build 0)"
                android:textColor="@color/app_dialog_subtitle_color"
                android:textSize="13sp" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/app_dialog_accent_color" />

            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/about_dialog_description"
                android:textColor="@color/app_dialog_title_color"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="@string/about_dialog_project_info"
                android:textColor="@color/app_dialog_subtitle_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/about_dialog_thanks"
                android:textColor="@color/app_dialog_subtitle_color"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/about_handbook_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/about_dialog_text_action_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/about_dialog_handbook_action"
                    android:textAllCaps="false"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/about_ecosystem_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/about_dialog_text_action_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/about_dialog_ecosystem_action"
                    android:textAllCaps="false"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/about_star_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/about_dialog_text_action_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/about_dialog_star"
                    android:textAllCaps="false"
                    android:textColor="@color/app_dialog_accent_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                layout="@layout/view_about_bilibili_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <com.limelight.ui.DialogSideScrollbarView
        android:id="@+id/about_dialog_scrollbar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="64dp"
        android:elevation="6dp" />

    <LinearLayout
        android:id="@+id/about_dialog_external_actions"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="@drawable/about_dialog_footer_bg"
        android:baselineAligned="false"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp">

        <Button
            android:id="@+id/about_github_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/about_dialog_text_action_bg"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/about_dialog_github"
            android:textAllCaps="true"
            android:textColor="@color/app_dialog_accent_color"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/about_qq_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/about_dialog_text_action_bg"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/about_dialog_qq"
            android:textAllCaps="true"
            android:textColor="@color/app_dialog_accent_color"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/about_site_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/about_dialog_text_action_bg"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/about_dialog_official_site"
            android:textAllCaps="true"
            android:textColor="@color/app_dialog_accent_color"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/about_close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/about_dialog_close_button_bg"
        android:contentDescription="@string/about_dialog_close"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_about_close" />
</FrameLayout>
