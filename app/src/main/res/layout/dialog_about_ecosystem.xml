<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_about_bg">

    <ScrollView
        android:id="@+id/about_ecosystem_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="30dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/about_ecosystem_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="48dp"
                android:text="@string/about_dialog_ecosystem_title"
                android:textColor="@color/app_dialog_title_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:paddingStart="0dp"
                android:paddingEnd="48dp"
                android:text="@string/about_dialog_ecosystem_lead"
                android:textColor="@color/app_dialog_subtitle_color"
                android:textSize="13sp" />

            <GridLayout
                android:id="@+id/about_ecosystem_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:orientation="horizontal"
                android:useDefaultMargins="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/about_dialog_ecosystem_footer"
                android:textColor="@color/app_dialog_subtitle_color"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <com.limelight.ui.DialogSideScrollbarView
        android:id="@+id/about_ecosystem_scrollbar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="10dp"
        android:elevation="6dp" />

    <ImageButton
        android:id="@+id/about_ecosystem_close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/about_dialog_close_button_bg"
        android:contentDescription="@string/about_dialog_close"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_about_close" />
</FrameLayout>
