<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/console_host_profile_item_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/console_host_profile_gap"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.limelight.ui.console.ConsoleCardView
        android:id="@+id/host_profile_avatar"
        android:layout_width="@dimen/console_host_profile_size"
        android:layout_height="@dimen/console_host_profile_size"
        android:defaultFocusHighlightEnabled="false"
        app:consoleCircular="true">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_computer"
            android:tint="@color/iris_text_primary" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/iris_chrome_icon_bg"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:tint="@color/iris_warning" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:indeterminateTint="@color/iris_cyan" />
    </com.limelight.ui.console.ConsoleCardView>

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/iris_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/grid_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
